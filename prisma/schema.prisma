generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id           String   @id @default(cuid())
  auth0Subject String   @unique
  displayName  String?
  email        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([auth0Subject])
}

model AppEventLog {
  id        String   @id @default(cuid())
  eventType String
  actorSub  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([eventType, createdAt])
  @@index([actorSub])
}

model ProcessedDataSource {
  id            String   @id @default(cuid())
  sourcePath    String   @unique
  sourceKind    String
  authorityRank Int      @default(100)
  description   String?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([sourceKind])
  @@index([authorityRank])
}

model KnowledgeChunk {
  id         String   @id @default(cuid())
  chunkKey   String   @unique
  sourcePath String
  parsedPath String?
  category   String
  title      String?
  body       String
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([category])
  @@index([sourcePath])
}

model RuntimeLookupRecord {
  id        String   @id @default(cuid())
  dataset   String
  recordKey String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([dataset, recordKey])
  @@index([dataset])
}

model RuntimeRule {
  id        String   @id @default(cuid())
  ruleset   String
  ruleKey   String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ruleset, ruleKey])
  @@index([ruleset])
}

model EventScenario {
  id           String   @id @default(cuid())
  scenarioKey  String   @unique
  scenarioType String?
  data         Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([scenarioType])
}

model OutputTemplate {
  id          String   @id @default(cuid())
  templateKey String   @unique
  format      String
  sourcePath  String
  body        String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([format])
}

model EventReadinessDraft {
  id           String   @id @default(cuid())
  ownerSubject String
  draftKey     String   @default("current")
  eventRequest Json?
  emailEdits   Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ownerSubject, draftKey])
  @@index([ownerSubject])
}

model EventReadinessEvent {
  id           String   @id @default(cuid())
  ownerSubject String
  draftKey     String
  eventRequest Json?
  emailEdits   Json     @default("{}")
  mondayMock   Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ownerSubject, draftKey])
  @@index([ownerSubject])
  @@index([createdAt])
}
